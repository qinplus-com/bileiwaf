/etc/admin.conf
/logs/
/data/
/certs/
rules/whitelist.ip.bak
rules.bak.*

# ---- GeoIP 数据库（MaxMind 许可，需自行下载）----
/geoip/*.mmdb

# ---- 发行产物 ----
/dist/
*.rpm
*.tar.gz

# ---- 编辑器与系统文件 ----
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/
