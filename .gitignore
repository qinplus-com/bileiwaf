# ---- 构建产物 ----
/Makefile
/config.log
/build/
/bin/
include/version.h
include/waf_config.h
*.o
*.a
*.so
*.d

# ---- 运行期数据（含敏感配置/日志/证书，严禁入库）----
/config/
